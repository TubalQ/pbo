#!/usr/bin/env bash
# mock pct: config/restore/start/exec/stop/destroy. Logs to $MOCK_LOG.
[ -n "${MOCK_LOG:-}" ] && echo "pct $*" >> "$MOCK_LOG"
case "${1:-}" in
  config)  f="$MOCK_CONF_DIR/${2}.conf"; [ -f "$f" ] && cat "$f" || exit 1 ;;
  restore) [ "${MOCK_RESTORE_OK:-1}" = 1 ] && exit 0 || exit 1 ;;
  start)   [ "${MOCK_START_OK:-1}" = 1 ] && exit 0 || exit 1 ;;
  exec)    [ "${MOCK_EXEC_OK:-1}" = 1 ] && exit 0 || exit 1 ;;
  stop)    exit 0 ;;
  destroy) exit 0 ;;
  *) exit 0 ;;
esac

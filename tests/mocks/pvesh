#!/usr/bin/env bash
# mock pvesh: answers by API path. Logs to $MOCK_LOG.
#   /cluster/backup  → the file $MOCK_PVESH_BACKUP_JSON, default []
#   /storage         → the file $MOCK_PVESH_STORAGE_JSON; without it the stanzas of
#                      $MOCK_STORAGE_CFG (storage.cfg format) as [{storage, type}]; default []
#   anything else    → the file $MOCK_PVESH_JSON; default empty, i.e. no cluster
#                      view, so cluster filtering is a no-op and an explicit
#                      BACKUP_ORDER is used as-is
#   MOCK_PVESH_FAIL_PATH="<path> [<path>...]": those paths exit 1
[ -n "${MOCK_LOG:-}" ] && echo "pvesh $*" >> "$MOCK_LOG"
path="${2:-}"
for p in ${MOCK_PVESH_FAIL_PATH:-}; do
    [ "$p" = "$path" ] && { echo "mock pvesh: $path failed" >&2; exit 1; }
done
case "$path" in
    /cluster/backup) if [ -n "${MOCK_PVESH_BACKUP_JSON:-}" ]; then cat "$MOCK_PVESH_BACKUP_JSON"; else echo '[]'; fi ;;
    /storage)        if [ -n "${MOCK_PVESH_STORAGE_JSON:-}" ]; then cat "$MOCK_PVESH_STORAGE_JSON"
                     elif [ -n "${MOCK_STORAGE_CFG:-}" ] && [ -f "$MOCK_STORAGE_CFG" ]; then
                         sed -nE 's/^([A-Za-z][A-Za-z0-9_-]*):[[:space:]]+([^[:space:]]+)[[:space:]]*$/{"storage":"\2","type":"\1"}/p' "$MOCK_STORAGE_CFG" | jq -cs .
                     else echo '[]'; fi ;;
    *)               cat "${MOCK_PVESH_JSON:-/dev/null}" 2>/dev/null || echo '[]' ;;
esac

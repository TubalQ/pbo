#!/usr/bin/env bash
# mock qm: by default this host has NO VMs, so `qm config <id>` fails and guests
# fall through to the LXC (pct) path. Set MOCK_QM_VMIDS="9101 9102" to make those
# ids look like VMs. Logs to $MOCK_LOG.
[ -n "${MOCK_LOG:-}" ] && echo "qm $*" >> "$MOCK_LOG"
is_vm() { case " ${MOCK_QM_VMIDS:-} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
case "${1:-}" in
  config)  is_vm "${2:-}" && { f="$MOCK_QM_CONF_DIR/${2}.conf"; [ -f "$f" ] && cat "$f" || echo "name: vm${2}"; exit 0; } || exit 1 ;;
  list)    echo "      VMID STATUS"; for v in ${MOCK_QM_VMIDS:-}; do echo "       $v running"; done; exit 0 ;;
  agent)   [ "${MOCK_AGENT_OK:-1}" = 1 ] && exit 0 || exit 1 ;;
  status)  echo "status: running"; exit 0 ;;
  start|stop|destroy) exit 0 ;;
  *) exit 0 ;;
esac

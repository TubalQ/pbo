# /etc/pbo/config, KEY=VALUE. chmod 600, root:root.
# This is the example/template, copied by install.sh. It contains no secrets
# (the restic repo password lives in RESTIC_PASSWORD_FILE, 0600).
#
# The easiest way to fill this in is the interactive wizard, which does the whole
# job in one pass (SSH key, host-key pinning, connection test, repo, DR key,
# retention, guest set, and enabling the timers):
#   pbo setup

# --- paths ---
CACHE_DIR=/var/cache/pbo
LOG_DIR=/var/log/pbo
STATE_DIR=/var/lib/pbo
LOCK_DIR=/var/lock

# --- vzdump ---
# Fuse containers (features fuse=1) are forced to --mode stop automatically.
# Add extra vmids here to force stop mode for them too (comma-separated).
VZDUMP_MODE=snapshot
VZDUMP_STOP_VMIDS=

# --- schedule ---
# auto  = back up every guest ON THIS NODE (LXC + VM), auto-discovering new ones.
# or a comma-separated vmid list for explicit order/exclusions (critical first).
# In a cluster: put the SAME config on every node, each node backs up only its
# own guests into the shared repo (an explicit list is filtered to local guests).
BACKUP_ORDER=auto
BACKUP_MODE=stream        # stream (one-by-one, low disk) | batch (dump all→upload)
GLOBAL_LOCK_TIMEOUT=7200  # seconds a scheduled run waits in the queue
# Cluster only: restrict `prune` to one node (prune needs an exclusive repo lock).
# Empty = any node may prune (restic's lock keeps concurrent attempts safe).
PRUNE_OWNER=

# --- retention (applied by the pbo-prune.timer, or `pbo prune`) ---
KEEP_LOCAL=2
KEEP_OFFSITE_DAILY=7
KEEP_OFFSITE_WEEKLY=4
KEEP_OFFSITE_MONTHLY=6

# --- notifications ---
NTFY_URL=
NTFY_TOPIC=
NTFY_ON_SUCCESS=false      # alert on failure, silent on success

# --- health check ---
DOCTOR_MAX_AGE=172800      # 48h, `pbo doctor` flags a guest whose newest snapshot is older

# --- restic repo ---
# Onboarding: run `pbo setup` (or set the keys below by hand + create the
# password file 0600 + run `pbo init` once before the first backup).
#RESTIC_BIN=restic                             # override in tests (scratch binary)
#LOCAL_REPO=true                               # true=cached (local repo+copy), false=offsite-only
#OFFSITE_ENABLED=true                          # false=local repo only (no offsite copy)
#RESTIC_CACHE_REPO=/var/cache/pbo/repo         # local restic repo (cache tier)
#RESTIC_OFFSITE_REPO=sftp:hetzner:lxc-restic   # native sftp, RELATIVE path (Storage Box is chrooted!)
# The Storage Box needs port/key in the ssh command (the repo URL's host label is just a name).
# `pbo setup` pins the host key into /etc/pbo/known_hosts and uses StrictHostKeyChecking=yes;
# the accept-new form below is the trust-on-first-use fallback.
#RESTIC_SFTP_COMMAND="ssh uXXXXX-subN@uXXXXX-subN.your-storagebox.de -p 23 -i /root/.ssh/id_ed25519 -o UserKnownHostsFile=/etc/pbo/known_hosts -o StrictHostKeyChecking=yes -s sftp"
#RESTIC_SFTP_CONNECTIONS=8                     # parallel sftp connections (faster restore; Storage Box ~10 max)
#RESTIC_PASSWORD_FILE=/etc/pbo/restic-pass     # repo password (DR key), 0600
#RESTIC_CACHE_DIR=/var/lib/pbo/restic-cache    # restic's own metadata cache
#TR_STORAGE=nvmepool                           # throwaway storage for test-restore

# --- host backup (`pbo backup-host`, manual only, tagged type=host) ---
# Space-separated. Missing paths are skipped silently (not an error).
#HOST_BACKUP_PATHS=/etc/pve /etc/network/interfaces /etc/network/interfaces.d /etc/hosts /etc/hostname /etc/resolv.conf /etc/fstab /etc/vzdump.conf /etc/pbo /etc/systemd/system /etc/cron.d /etc/apt/sources.list /etc/apt/sources.list.d
# SSH keys and the DR key are excluded by default: secrets never go in the repo
# they protect, and the host must keep its own offline copy of its keys.
#HOST_BACKUP_EXCLUDES=/etc/pbo/restic-pass /root/.ssh **/.ssh **/id_rsa **/id_ed25519 **/id_ecdsa

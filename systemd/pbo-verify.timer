[Unit]
Description=Weekly pbo integrity check (rotating deep read)
Documentation=https://github.com/TubalQ/pbo

[Timer]
# The defaults of SCHEDULE_VERIFY (OnCalendar=) and SCHEDULE_VERIFY_DELAY
# (RandomizedDelaySec=) in lib/config_schema.sh; tests check they agree.
# `pbo config set SCHEDULE_VERIFY ...` changes it with a drop-in
# (pbo-verify.timer.d/schedule.conf): an edit here is undone by a reinstall.
# Wednesdays 10:00, away from the nightly backup and the Sunday prune.
# With VERIFY_ROTATE=12 the whole repo is read about once a quarter.
OnCalendar=Wed *-*-* 10:00:00
Persistent=true
RandomizedDelaySec=30m

[Install]
WantedBy=timers.target

[Unit]
Description=lxc-offsite web console (FastAPI)
Documentation=https://git.midvault.se/ai-pvet440/lxc-offsite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# v1: kör som root (CLI kräver pct/vzdump). Steg 13: dedikerad användare + sudoers.
# v1: ingen inbyggd auth än → bind LAN, lägg bakom traefik+forward-auth före
# exponering utanför LAN. Endast läs-endpoints exponerade i v1.
ExecStart=/opt/lxc-offsite/api/venv/bin/uvicorn app:app --app-dir /opt/lxc-offsite/api --host 0.0.0.0 --port 8008
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

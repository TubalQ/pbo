[Unit]
Description=pbo: read-only restic mount of the cache repo (Proxmox restore and Show Configuration)
Documentation=https://github.com/TubalQ/PBO
After=local-fs.target
# Started on demand by `pbo catalog materialize` (unless PVE_CATALOG_MOUNT=false),
# stopped by `pbo catalog release` (pbo-catalog.service) when idle and by
# prune/verify before they take exclusive repo locks; never while a process reads
# through it (a running restore). Never enabled at boot.

[Service]
Type=simple
# runs `restic mount <cache repo> /run/pbo/mnt` in the foreground (PVE_CATALOG_MOUNT_DIR)
ExecStart=/usr/local/lib/pbo/pbo catalog _mount
# restic unmounts on SIGTERM; the lazy unmount covers a restic that died hard
ExecStopPost=-/bin/umount -l /run/pbo/mnt
TimeoutStopSec=30s
Restart=no
Nice=10
IOSchedulingClass=idle

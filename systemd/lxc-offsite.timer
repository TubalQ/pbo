[Unit]
Description=Daily lxc-offsite offsite backup
Documentation=https://github.com/ai-pvet440/lxc-offsite

[Timer]
# 05:00 every night.
OnCalendar=*-*-* 05:00:00
Persistent=true
# No RandomizedDelaySec: the run is sequential and the start time should be predictable.

[Install]
WantedBy=timers.target

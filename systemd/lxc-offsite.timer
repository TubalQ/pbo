[Unit]
Description=Daglig lxc-offsite offsite-backup
Documentation=https://git.midvault.se/ai-pvet440/lxc-offsite

[Timer]
# 05:00 varje natt (restic offsite; PBS avvecklas → detta blir primärt).
OnCalendar=*-*-* 05:00:00
Persistent=true
# Ingen RandomizedDelaySec: körningen är sekventiell, starttiden ska vara förutsägbar.

[Install]
WantedBy=timers.target

set -Eeuo pipefail

# Hitta den egna katalogen så lib/ funkar både i repo och installerat (följ
# symlänken /usr/local/sbin/lxc-offsite → /usr/local/lib/lxc-offsite/lxc-offsite).
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/common.sh
source "${SELF_DIR}/lib/common.sh"
# shellcheck source=lib/notify.sh  (ersätter notify-stubbarna i common.sh)
source "${SELF_DIR}/lib/notify.sh"
# shellcheck source=lib/lock.sh
source "${SELF_DIR}/lib/lock.sh"
# shellcheck source=lib/preflight.sh
source "${SELF_DIR}/lib/preflight.sh"
# shellcheck source=lib/backup.sh
source "${SELF_DIR}/lib/backup.sh"
# shellcheck source=lib/upload.sh
source "${SELF_DIR}/lib/upload.sh"
# shellcheck source=lib/list.sh
source "${SELF_DIR}/lib/list.sh"
# shellcheck source=lib/restore.sh
source "${SELF_DIR}/lib/restore.sh"
# shellcheck source=lib/prune.sh
source "${SELF_DIR}/lib/prune.sh"
# shellcheck source=lib/testrestore.sh
source "${SELF_DIR}/lib/testrestore.sh"
# shellcheck source=lib/schedule.sh
source "${SELF_DIR}/lib/schedule.sh"
# shellcheck source=lib/restic.sh  (restic-motorn, aktiveras med ENGINE=restic)
source "${SELF_DIR}/lib/restic.sh"

readonly VERSION="0.1.0-dev"

# ---------------------------------------------------------------------------
# Globala flaggor (före subkommandot). --json och --dry-run är globala och
# måste finnas från början — GUI:t konsumerar ENBART --json-output.
# ---------------------------------------------------------------------------
JSON_OUTPUT=0
DRY_RUN=0
LXCO_COMMAND=""

usage() {
    cat <<'EOF'
lxc-offsite — offsite-backup av Proxmox-LXC:er till Hetzner Storage Box.

Användning:
  lxc-offsite [globala flaggor] <kommando> [argument]

Globala flaggor:
  --json              maskinläsbar utdata på stdout (GUI:t använder denna)
  --dry-run           visa vad som skulle göras, ändra ingenting
  -h, --help          denna hjälp
  -V, --version       versionsnummer

Kommandon:
  backup <vmid>               dump→verifiera→ladda upp→verifiera→prune (globalt lås)
  preflight <vmid>            kör enbart förkontrollerna (finns/utrymme/cache/rclone)
  run-schedule                backup för varje vmid i BACKUP_ORDER, sekventiellt (köar)
  status                      pågående jobb, kölängd, vem som håller globala låset
  list [vmid]                 lista offsite-arkiv (storlek, datum)
  fetch <vmid> <ts>           hämta ett arkiv till cache, verifiera (inget globalt lås)
  restore <vmid> <ts> --to N  fetch + pct restore till nytt vmid (inget globalt lås)
  verify <vmid>               jämför lokala och offsite-hashar
  prune                       städa cache och offsite enligt policy
  test-restore <vmid>         full restore till engångs-vmid, boot, destroy

Exit-koder: 0 ok · 64 användningsfel · 75 lås upptaget/kö · 78 configfel.
EOF
}

# ---------------------------------------------------------------------------
# Parsa globala flaggor fram till första icke-flagg-argumentet (kommandot).
# ---------------------------------------------------------------------------
parse_global_flags() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)     JSON_OUTPUT=1; shift ;;
            --dry-run)  DRY_RUN=1; shift ;;
            -h|--help)  usage; exit "$EX_OK" ;;
            -V|--version) printf 'lxc-offsite %s\n' "$VERSION"; exit "$EX_OK" ;;
            --) shift; break ;;
            -*) printf 'okänd global flagga: %s\n' "$1" >&2; usage >&2; exit "$EX_USAGE" ;;
            *)  break ;;
        esac
    done
    REMAINING_ARGS=("$@")
}

# ---------------------------------------------------------------------------
# Subkommando-hanterare. Steg 1: låsen wire:as korrekt så att de bevisligen
# sitter rätt, men själva operationen svarar not_implemented.
# ---------------------------------------------------------------------------

# backup [--queue] <vmid>
# Manuellt (default): "now"-läge — avslutar direkt om globala låset är upptaget.
# --queue: schemaläget — köar på globala låset (används internt av run-schedule).
cmd_backup() {
    local mode="now"
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            --queue) mode="queue"; shift ;;
            --now)   mode="now"; shift ;;
            *) die "$EX_USAGE" "okänd backup-flagga: $1" ;;
        esac
    done
    require_vmid "${1:-}"
    local vmid="$1"
    acquire_vmid_lock "$vmid"
    acquire_global_lock "$mode" "backup" "$vmid"

    # Steg 2: preflight. FAIL → avbryt innan någon dump.
    local rc=0
    run_preflight "$vmid" || rc=$?
    if (( rc != 0 )); then
        [[ "${JSON_OUTPUT:-0}" == 1 ]] && emit_preflight_json "$vmid" "$rc"
        die "$EX_UNAVAILABLE" "preflight underkänd för vmid $vmid — backup avbruten."
    fi

    # Steg 3: dump + lokal verifiering + meta. Steg 4 lägger till uppladdning.
    do_backup "$vmid"
}

# preflight <vmid> — kör enbart förkontrollerna (även intern del av backup).
cmd_preflight() {
    require_vmid "${1:-}"
    local vmid="$1" rc=0
    run_preflight "$vmid" || rc=$?
    [[ "${JSON_OUTPUT:-0}" == 1 ]] && emit_preflight_json "$vmid" "$rc"
    return "$rc"
}

# run-schedule — schemalagd: köar på globala låset per container, sekventiellt.
cmd_run_schedule() { do_run_schedule; }

# status — läsoperation, inget lås.
cmd_status() { do_status; }

# fetch/restore — tar ALDRIG globalt lås (skriver inte från poolen).
cmd_fetch() {
    require_vmid "${1:-}"
    [[ -n "${2:-}" ]] || die "$EX_USAGE" "fetch kräver <vmid> <timestamp>"
    acquire_vmid_lock "$1"
    do_fetch "$1" "$2"
}

# restore <vmid> <ts> --to <nytt-vmid> [--storage <pool>] [--yes]
cmd_restore() {
    require_vmid "${1:-}"
    local src="$1" ts="${2:-}"
    [[ -n "$ts" ]] || die "$EX_USAGE" "restore kräver <vmid> <ts> --to <nytt-vmid>"
    shift 2 || true
    local newid="" storage="" yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to)      newid="$2"; shift 2 ;;
            --storage) storage="$2"; shift 2 ;;
            --yes)     yes=1; shift ;;
            *) die "$EX_USAGE" "okänd restore-flagga: $1" ;;
        esac
    done
    is_vmid "$newid" || die "$EX_USAGE" "restore kräver --to <nytt-vmid> (giltigt vmid)"
    acquire_vmid_lock "$newid"
    do_restore "$src" "$ts" "$newid" "$storage" "$yes"
}

cmd_init()         { if [[ "${ENGINE:-tar}" == "restic" ]]; then restic_init; [[ "${JSON_OUTPUT:-0}" == 1 ]] && json_result "ok" "true" "engine" "restic" || log_info "restic: repo(s) init:ade/klara"; else log_warn "init: bara meningsfullt med ENGINE=restic"; fi; }
cmd_list()         { do_list "${1:-}"; }
cmd_verify()       { if [[ "${ENGINE:-tar}" == "restic" ]]; then rdo_verify; else require_vmid "${1:-}"; not_implemented; fi; }
cmd_prune()        { do_prune; }
cmd_test_restore() { require_vmid "${1:-}"; acquire_vmid_lock "$1"; do_test_restore "$1"; }

# ---------------------------------------------------------------------------
# Main.
# ---------------------------------------------------------------------------
main() {
    parse_global_flags "$@"
    set -- "${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}"

    LXCO_COMMAND="${1:-}"
    [[ -n "$LXCO_COMMAND" ]] || { usage >&2; exit "$EX_USAGE"; }
    shift || true

    load_config
    trap cleanup_locks EXIT

    case "$LXCO_COMMAND" in
        init)          cmd_init "$@" ;;
        backup)        cmd_backup "$@" ;;
        preflight)     cmd_preflight "$@" ;;
        run-schedule)  cmd_run_schedule "$@" ;;
        status)        cmd_status "$@" ;;
        list)          cmd_list "$@" ;;
        fetch)         cmd_fetch "$@" ;;
        restore)       cmd_restore "$@" ;;
        verify)        cmd_verify "$@" ;;
        prune)         cmd_prune "$@" ;;
        test-restore)  cmd_test_restore "$@" ;;
        help)          usage ;;
        *) printf 'okänt kommando: %s\n' "$LXCO_COMMAND" >&2; usage >&2; exit "$EX_USAGE" ;;
    esac
}

main "$@"

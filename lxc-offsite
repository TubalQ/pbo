#!/usr/bin/env bash
# lxc-offsite — offsite backup of Proxmox LXCs to any SFTP target (e.g. Hetzner
# Storage Box), using restic as the backup engine.
# Copyright (C) 2026  ai-pvet440
# License: AGPL-3.0-or-later (see LICENSE).
#
# Dispatcher: sources lib/*.sh, parses global flags, dispatches subcommands.
# Two-level locking (global + per-vmid), --dry-run/--json global flags.
#
# Run on the Proxmox HOST (requires pct/vzdump). See README.md for the big picture.

set -Eeuo pipefail

# Resolve our own directory so lib/ works both from the repo and when installed
# (follow the symlink /usr/local/sbin/lxc-offsite → /usr/local/lib/lxc-offsite/lxc-offsite).
SELF_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/common.sh
source "${SELF_DIR}/lib/common.sh"
# shellcheck source=lib/notify.sh  (replaces the notify stubs in common.sh)
source "${SELF_DIR}/lib/notify.sh"
# shellcheck source=lib/lock.sh
source "${SELF_DIR}/lib/lock.sh"
# shellcheck source=lib/preflight.sh
source "${SELF_DIR}/lib/preflight.sh"
# shellcheck source=lib/backup.sh
source "${SELF_DIR}/lib/backup.sh"
# shellcheck source=lib/upload.sh
source "${SELF_DIR}/lib/upload.sh"
# shellcheck source=lib/list.sh
source "${SELF_DIR}/lib/list.sh"
# shellcheck source=lib/restore.sh
source "${SELF_DIR}/lib/restore.sh"
# shellcheck source=lib/prune.sh
source "${SELF_DIR}/lib/prune.sh"
# shellcheck source=lib/testrestore.sh
source "${SELF_DIR}/lib/testrestore.sh"
# shellcheck source=lib/schedule.sh
source "${SELF_DIR}/lib/schedule.sh"
# shellcheck source=lib/restic.sh  (the restic engine, enabled with ENGINE=restic)
source "${SELF_DIR}/lib/restic.sh"
# shellcheck source=lib/tui.sh  (legacy Textual TUI, `lxc-offsite tui` — frozen)
source "${SELF_DIR}/lib/tui.sh"
# shellcheck source=lib/menu.sh  (interactive prompt-CLI, `lxc-offsite menu`)
source "${SELF_DIR}/lib/menu.sh"

readonly VERSION="0.1.0-dev"

# ---------------------------------------------------------------------------
# Global flags (before the subcommand). --json and --dry-run are global and
# must be available from the start — machine-readable output uses --json only.
# ---------------------------------------------------------------------------
JSON_OUTPUT=0
DRY_RUN=0
LXCO_COMMAND=""

usage() {
    cat <<'EOF'
lxc-offsite — offsite backup of Proxmox LXCs to any SFTP target, via restic.

Usage:
  lxc-offsite [global flags] <command> [arguments]

Global flags:
  --json              machine-readable output on stdout
  --dry-run           show what would be done, change nothing
  -h, --help          this help
  -V, --version       version number

Commands:
  setup                       interactive setup wizard (engine/cache/sftp/password/mode/ntfy → init)
  menu                        interactive prompt-CLI (rclone style) — guests/backup/restore/status
  tui                         (legacy) whiptail TUI — frozen in favor of `menu`
  init                        (restic) create/verify repo(s)
  backup <vmid>               dump→verify→upload→verify→prune (global lock)
  preflight <vmid>            run the preflight checks only (exists/space/cache/repo)
  run-schedule [--stream|--batch]  back up everything in BACKUP_ORDER → the SAME repo
                              --stream: dump→upload one at a time (low disk, default)
                              --batch:  dump all to cache→upload (if there is room)
  status                      running jobs, queue length, who holds the global lock
  list [vmid]                 list offsite archives (size, date)
  fetch <vmid> <ts>           fetch one archive into cache, verify (no global lock)
  restore <vmid> <ts> --to N  fetch + pct restore to a new vmid (no global lock)
  verify <vmid>               verify repo integrity (restic check)
  prune                       clean cache and offsite per policy
  test-restore <vmid>         full restore to a throwaway vmid, boot, destroy

Exit codes: 0 ok · 64 usage error · 75 lock busy/queue · 78 config error.
EOF
}

# ---------------------------------------------------------------------------
# Parse global flags up to the first non-flag argument (the command).
# ---------------------------------------------------------------------------
parse_global_flags() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)     JSON_OUTPUT=1; shift ;;
            --dry-run)  DRY_RUN=1; shift ;;
            -h|--help)  usage; exit "$EX_OK" ;;
            -V|--version) printf 'lxc-offsite %s\n' "$VERSION"; exit "$EX_OK" ;;
            --) shift; break ;;
            -*) printf 'unknown global flag: %s\n' "$1" >&2; usage >&2; exit "$EX_USAGE" ;;
            *)  break ;;
        esac
    done
    REMAINING_ARGS=("$@")
}

# ---------------------------------------------------------------------------
# Subcommand handlers. Each acquires the locks it needs, then calls the
# operation in the relevant lib file.
# ---------------------------------------------------------------------------

# backup [--queue] <vmid>
# Manual (default): "now" mode — exits immediately if the global lock is busy.
# --queue: scheduled mode — queues on the global lock (used internally by run-schedule).
cmd_backup() {
    local mode="now"
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            --queue) mode="queue"; shift ;;
            --now)   mode="now"; shift ;;
            *) die "$EX_USAGE" "unknown backup flag: $1" ;;
        esac
    done
    require_vmid "${1:-}"
    local vmid="$1"
    acquire_vmid_lock "$vmid"
    acquire_global_lock "$mode" "backup" "$vmid"

    # Preflight. FAIL → abort before any dump.
    local rc=0
    run_preflight "$vmid" || rc=$?
    if (( rc != 0 )); then
        [[ "${JSON_OUTPUT:-0}" == 1 ]] && emit_preflight_json "$vmid" "$rc"
        die "$EX_UNAVAILABLE" "preflight failed for vmid $vmid — backup aborted."
    fi

    # dump + local verify + meta + upload.
    do_backup "$vmid"
}

# preflight <vmid> — run the preflight checks only (also an internal part of backup).
cmd_preflight() {
    require_vmid "${1:-}"
    local vmid="$1" rc=0
    run_preflight "$vmid" || rc=$?
    [[ "${JSON_OUTPUT:-0}" == 1 ]] && emit_preflight_json "$vmid" "$rc"
    return "$rc"
}

# run-schedule — scheduled backup of everything in BACKUP_ORDER. --stream (one-by-one,
# default) or --batch (dump all→upload), always to the SAME repo.
cmd_run_schedule() {
    case "${1:-}" in
        --batch)  BACKUP_MODE=batch ;;
        --stream) BACKUP_MODE=stream ;;
        "" ) : ;;
        *) die "$EX_USAGE" "unknown run-schedule flag: $1 (use --stream|--batch)" ;;
    esac
    do_run_schedule
}

# status — read operation, no lock.
cmd_status() { do_status; }

# fetch/restore — NEVER take the global lock (they do not write from the pool).
cmd_fetch() {
    require_vmid "${1:-}"
    [[ -n "${2:-}" ]] || die "$EX_USAGE" "fetch requires <vmid> <timestamp>"
    acquire_vmid_lock "$1"
    do_fetch "$1" "$2"
}

# restore <vmid> <ts> --to <new-vmid> [--storage <pool>] [--yes]
cmd_restore() {
    require_vmid "${1:-}"
    local src="$1" ts="${2:-}"
    [[ -n "$ts" ]] || die "$EX_USAGE" "restore requires <vmid> <ts> --to <new-vmid>"
    shift 2 || true
    local newid="" storage="" yes=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --to)      newid="$2"; shift 2 ;;
            --storage) storage="$2"; shift 2 ;;
            --yes)     yes=1; shift ;;
            *) die "$EX_USAGE" "unknown restore flag: $1" ;;
        esac
    done
    is_vmid "$newid" || die "$EX_USAGE" "restore requires --to <new-vmid> (a valid vmid)"
    acquire_vmid_lock "$newid"
    do_restore "$src" "$ts" "$newid" "$storage" "$yes"
}

cmd_init()         { if [[ "${ENGINE:-tar}" == "restic" ]]; then restic_init; [[ "${JSON_OUTPUT:-0}" == 1 ]] && json_result "ok" "true" "engine" "restic" || log_info "restic: repo(s) initialized/ready"; else log_warn "init: only meaningful with ENGINE=restic"; fi; }
cmd_menu()         { menu_main; }
cmd_setup()        { run_setup_wizard; }
cmd_tui() {
    # Legacy whiptail TUI, frozen in favor of `menu`. --selftest checks wiring (no TTY).
    case "${1:-}" in
        --selftest) _tui_selftest; return ;;
    esac
    tui_main
}
cmd_list()         { do_list "${1:-}"; }
cmd_usage()        { if [[ "${ENGINE:-tar}" == "restic" ]]; then rdo_usage; else not_implemented; fi; }
cmd_verify()       { if [[ "${ENGINE:-tar}" == "restic" ]]; then rdo_verify; else require_vmid "${1:-}"; not_implemented; fi; }
cmd_prune()        { do_prune; }
cmd_test_restore() { require_vmid "${1:-}"; acquire_vmid_lock "$1"; do_test_restore "$1"; }

# ---------------------------------------------------------------------------
# Main.
# ---------------------------------------------------------------------------
main() {
    parse_global_flags "$@"
    set -- "${REMAINING_ARGS[@]+"${REMAINING_ARGS[@]}"}"

    LXCO_COMMAND="${1:-}"
    [[ -n "$LXCO_COMMAND" ]] || { usage >&2; exit "$EX_USAGE"; }
    shift || true

    load_config
    trap cleanup_locks EXIT

    case "$LXCO_COMMAND" in
        init)          cmd_init "$@" ;;
        setup)         cmd_setup "$@" ;;
        menu)          cmd_menu "$@" ;;
        tui)           cmd_tui "$@" ;;
        backup)        cmd_backup "$@" ;;
        preflight)     cmd_preflight "$@" ;;
        run-schedule)  cmd_run_schedule "$@" ;;
        status)        cmd_status "$@" ;;
        list)          cmd_list "$@" ;;
        usage)         cmd_usage "$@" ;;
        fetch)         cmd_fetch "$@" ;;
        restore)       cmd_restore "$@" ;;
        verify)        cmd_verify "$@" ;;
        prune)         cmd_prune "$@" ;;
        test-restore)  cmd_test_restore "$@" ;;
        help)          usage ;;
        *) printf 'unknown command: %s\n' "$LXCO_COMMAND" >&2; usage >&2; exit "$EX_USAGE" ;;
    esac
}

main "$@"

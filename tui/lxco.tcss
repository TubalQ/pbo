/* lxc-offsite TUI — Textual stylesheet (mörk, modern, PBS-nära) */

Screen {
    background: $surface;
    color: $text;
}

/* status-rad överst */
#statusbar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $text-muted;
}
#statusbar .ok    { color: $success; text-style: bold; }
#statusbar .warn  { color: $warning; text-style: bold; }
#statusbar .accent{ color: $accent;  text-style: bold; }

TabbedContent { height: 1fr; }
TabPane { padding: 1 2; }

/* ---- Dashboard: kort-rutnät ---- */
#cards {
    grid-size: 3;
    grid-gutter: 1 2;
    grid-rows: 5;
    height: auto;
    margin-bottom: 1;
}
#mcards {
    grid-size: 4;
    grid-gutter: 1 2;
    grid-rows: 5;
    height: auto;
}
.card {
    border: round $primary 40%;
    background: $panel;
    padding: 0 1;
    height: 5;
}
.card .k { color: $text-muted; text-style: none; }
.card .v { text-style: bold; }
.card.good  { border: round $success; }
.card.good .v  { color: $success; }
.card.warn  { border: round $warning; }
.card.warn .v  { color: $warning; }
.card.accent .v { color: $accent; }

.section-title {
    text-style: bold;
    color: $accent;
    margin: 1 0 0 0;
}

DataTable { height: auto; max-height: 20; border: round $primary 30%; }
DataTable > .datatable--header { background: $panel; text-style: bold; }
DataTable > .datatable--cursor { background: $accent 40%; }

/* ---- knapprader ---- */
.toolbar { height: auto; padding: 1 0; }
.toolbar Button { margin: 0 2 0 0; }
Button { min-width: 16; }
Button.-primary { background: $accent; color: $text; text-style: bold; }
Button.-danger  { background: $error; color: $text; }

/* ---- formulär (Setup) ---- */
.form { padding: 0 0; }
.form .row { height: 3; }
.form Label { width: 22; content-align: left middle; color: $text-muted; }
.form Input, .form Select { width: 1fr; }
.help { color: $text-muted; margin: 1 0; }

/* ---- modaler ---- */
LogScreen {
    align: center middle;
}
#logbox {
    width: 90%;
    height: 80%;
    border: round $accent;
    background: $panel;
}
#logtitle { dock: top; height: 1; padding: 0 1; background: $accent; color: $text; text-style: bold; }
RichLog { padding: 0 1; }
#logfoot { dock: bottom; height: 1; padding: 0 1; color: $text-muted; }

FormModal { align: center middle; }
#formbox {
    width: 70;
    height: auto;
    border: round $accent;
    background: $panel;
    padding: 1 2;
}
#formbox .mtitle { text-style: bold; color: $accent; margin-bottom: 1; }
#formbox .row { height: 3; }
#formbox Label { width: 16; content-align: left middle; color: $text-muted; }
